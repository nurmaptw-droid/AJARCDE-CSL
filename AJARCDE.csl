<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0.2"
       class="in-text" default-locale="en-US">
  <info>
    <title>AJARCDE</title>
    <title-short>AJARCDE</title-short>
    <id>http://www.zotero.org/styles/ajarcde</id>
    <link href="http://www.zotero.org/styles/ajarcde" rel="self"/>
    <link href="https://www.ajarcde-safe-network.org/" rel="documentation"/>
    <updated>2026-10-02T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">
      Creative Commons Attribution-ShareAlike 3.0 License
    </rights>
    <summary>AJARCDE author-date citation style based on the journal's published citation examples.</summary>
    <author>
      <name>Custom style generated for AJARCDE</name>
    </author>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="et-al">et al.</term>
      <term name="page-range-delimiter">–</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            delimiter=", "
            and="text"
            delimiter-precedes-last="always"
            et-al-min="11"
            et-al-use-first="10"/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-short">
    <names variable="author">
      <name form="short"
            and="symbol"
            delimiter=", "
            delimiter-precedes-last="always"
            et-al-min="3"
            et-al-use-first="1"/>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="container-title">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <macro name="journal-details">
    <group delimiter=", ">
      <group delimiter="">
        <text variable="volume" font-style="italic"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="issued-year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" et-al-min="11" et-al-use-first="10">
    <sort>
      <key macro="author"/>
      <key macro="issued-year"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author"/>
        <date variable="issued" prefix="(" suffix=").">
          <date-part name="year"/>
        </date>
        <text macro="title"/>
        <choose>
          <if type="article-journal" variable="container-title">
            <group delimiter=", ">
              <text macro="container-title"/>
              <text macro="journal-details"/>
            </group>
          </if>
          <else-if type="article-magazine article-newspaper" variable="container-title">
            <group delimiter=", ">
              <text macro="container-title"/>
              <text macro="journal-details"/>
            </group>
          </else-if>
          <else-if type="paper-conference" variable="container-title">
            <group delimiter=", ">
              <text macro="container-title"/>
              <text variable="volume" font-style="italic"/>
              <text variable="page"/>
            </group>
          </else-if>
          <else-if type="chapter paper-conference" variable="container-title">
            <group delimiter=", ">
              <text macro="container-title"/>
              <text variable="page"/>
            </group>
          </else-if>
          <else>
            <text variable="publisher"/>
          </else>
        </choose>
      </group>
      <text macro="doi" prefix=" " />
    </layout>
  </bibliography>
</style>
